# Copy to deploy/production.env on moonhub-web (0600, ignored by Git).
# Preserve the existing volume names, secret paths and ports on an existing host.
MOONHUB_COMPOSE_PROJECT_NAME=moonhub-prod
MOONHUB_HTTP_BIND=127.0.0.1
MOONHUB_HTTP_PORT=18080
MOONHUB_SSH_PORT=22
MOONHUB_DATA_VOLUME=replace-with-existing-data-volume
MOONHUB_SSH_KEYS_VOLUME=replace-with-existing-ssh-host-keys-volume
MOONHUB_ROOT_PASSWORD_FILE=/etc/moonhub/root_password
MOONHUB_SSH_IMPORT_DIR=/etc/moonhub/ssh-import
MOONHUB_BACKUP_DIR=/srv/moonhub/backups
MOONHUB_DEPLOY_LOCK_DIR=/tmp/moonhub-prod-deploy.lock
MOONHUB_SERVER=https://moonhub-dev.mooncakes.io
MOONHUB_PROVIDER_NAME=asg
MOONHUB_PROVIDER_LABELS=self-hosted,linux,moonhub-build
MOONHUB_PROVIDER_SCOPE=all
MOONHUB_PROVIDER_REPOSITORIES=
MOONHUB_AWS_REGION=us-west-2
MOONHUB_AWS_CLI=/usr/local/bin/aws
MOONHUB_ECR_REPOSITORY=242126390740.dkr.ecr.us-west-2.amazonaws.com/moonhub-runner
MOONHUB_ASG=moonhub-runner-on-demand
MOONHUB_SPOT_ASG=moonhub-runner-spot
MOONHUB_LAUNCH_TEMPLATE=replace-with-launch-template-id
MOONHUB_INSTANCE_TYPES=m6a.large,c6a.xlarge
MOONHUB_PARAMETER_PREFIX=/moonhub-runner/production
MOONHUB_CONTROLLER_STATE_DIR=/var/lib/moonhub-runner/controller
MOONHUB_REGISTRATION_TOKEN_FILE=/etc/moonhub-runner/registration-token
# Maximum wait for worker/ASG drain when replacing the controller (0–3600 seconds):
# MOONHUB_PRODUCTION_DRAIN_TIMEOUT=600
# Optional reuse of the existing bounded production build cache:
# MOONHUB_BUILD_CONTAINER=moonhub-branch-buildkit
# MOONHUB_BUILD_CACHE=moonhub-branch-build-cache
# MOONHUB_BUILD_OWNER=standalone-runner
