# Operator settings only. Copy into the Git-ignored deploy/deploy.env.
MOONHUB_COMPOSE_PROJECT_NAME=moonhub-prod
MOONHUB_ENABLE_PIPELINES=1
MOONHUB_SHARED_HOST=1
MOONHUB_CGROUP_PARENT=moonhub.slice
MOONHUB_DIND_STORAGE_DIR=/srv/moonhub/dind/docker
MOONHUB_BUILD_IMAGES=1
MOONHUB_PULL=0
MOONHUB_HTTP_BIND=127.0.0.1
MOONHUB_HTTP_PORT=18080
MOONHUB_SSH_PORT=12222
MOONHUB_RUNNER_MEMORY=4g
MOONHUB_RUNNER_CPUS=2
MOONHUB_RUNNER_PIDS_LIMIT=256
# Keep secret file paths private; never commit their contents.
# Do not set fixed MOONHUB_IMAGE/PROVIDER_IMAGE/RUNNER_IMAGE when building.
# Set MOONHUB_SSH_PUBLIC_URL to your own site's ssh://git@HOST:12222 address.
