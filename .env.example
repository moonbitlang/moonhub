DB_PATH=moonhub.db

# Development mail outbox. SMTP is configured from the site settings page.
MAIL_OUTBOX_DIR=_build/mail_outbox

# Docker Compose publishes HTTP on loopback and SSH on all interfaces by default.
# MOONHUB_HTTP_BIND=127.0.0.1
# MOONHUB_HTTP_PORT=8080
# MOONHUB_SSH_BIND=0.0.0.0
# MOONHUB_SSH_PORT=2222
# MOONHUB_ROOT_USER=root
# The Docker bootstrap secret lives in deploy/secrets/root_password, not this file.

# Optional deployment override for Settings > SSH access (locks the admin form).
# Leave unset to manage the public hostname and port in the web UI.
# MOONHUB_SSH_PUBLIC_URL=ssh://git@git.example.com:2222
# Internal transport for imports from this instance; not a client-facing address.
# Compose defaults to the SSH service on its container port.
# MOONHUB_SSH_INTERNAL_URL=ssh://git@ssh:2222

# Team-scoped outbound SSH import credentials (Docker bind-mount source).
# MOONHUB_SSH_IMPORT_DIR=./deploy/ssh-import
# MOONHUB_IMPORT_TIMEOUT_SECONDS=300

# Optional workflow OIDC issuer. Mount this private file only into the Web service.
# See docs/workflow-oidc.md for generation, IAM trust and key rotation.
# MOONHUB_OIDC_CONFIG=/absolute/private/oidc.json
# MOONHUB_OIDC_NODE=/usr/local/bin/node
# Host file for the tracked Compose deployment scripts (enables the Web-only mount):
# MOONHUB_OIDC_CONFIG_FILE=/etc/moonhub/workflow-oidc.json

# The production image installs the isolated MoonDiff worker on PATH.
# For local development: moon build --strip -j 1 cmd/moonhub-diff-worker
# The path below is for a local Web process; Compose requires a container path.
# MOONHUB_DIFF_WORKER=/absolute/path/to/moonhub-diff-worker.exe
MOONHUB_WEB_MOONDIFF=true
MOONHUB_DIFF_CONCURRENCY=1
MOONHUB_DIFF_DEADLINE_MS=5000
# Shared manifest/file retained-memory estimate; 0 disables caching.
MOONHUB_DIFF_CACHE_BYTES=33554432

# Optional independent fs/S3 backends for artifacts and CI caches.
# See docs/blob-storage.md. No configuration preserves existing local storage.
# MOONHUB_STORAGE_CONFIG=/absolute/private/storage.json
# Host path for tracked Compose deployment (mounts into Web only):
# MOONHUB_STORAGE_CONFIG_FILE=/etc/moonhub/storage.json

# Optional Web-only SDK profile directory for short-lived storage role identity:
# MOONHUB_STORAGE_AWS_DIR=/etc/moonhub/storage-aws
