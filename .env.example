DB_PATH=moonhub.db

# Development mail transport. Writes invitation emails to MAIL_OUTBOX_DIR.
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=_build/mail_outbox

# SMTP transport. Uncomment and fill these values to send real email.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_AUTH=plain
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=noreply@example.com
